# Variables de docker compose (en Dokploy: pestaña Environment). No se suben al repo.
# URL interna de la BD de Dokploy (Database > Internal Connection URL)
DATABASE_URL="postgresql://usuario:password@host:5432/cosmoflow_db?schema=public"
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET="cambia_este_secreto_por_uno_de_32_caracteres_o_mas"
# Dominio público de la app (enlaces de los correos), p. ej. https://app.tu-dominio.com
APP_URL="https://app.tu-dominio.com"
# Sin SMTP_HOST ni RESEND_API_KEY no se envía ningún correo (recuperar contraseña, verificar email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# "true" para TLS directo (normalmente puerto 465); "false" para STARTTLS (normalmente puerto 587)
SMTP_SECURE="false"
RESEND_API_KEY=""
# Suele tener que ser una dirección del dominio o de la cuenta SMTP_USER
MAIL_FROM="Cosmoflow <no-reply@tu-dominio.com>"
# Login con Google (console.cloud.google.com > Credenciales > ID de cliente OAuth, tipo "Aplicación web").
# URI de redirección autorizada: <APP_URL>/api/auth/google/callback. Vacías: login con Google desactivado
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
