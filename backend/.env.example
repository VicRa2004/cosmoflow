# URL de tu PostgreSQL local (ajusta credenciales, host y puerto)
DATABASE_URL="postgresql://cosmoflow:cambia_esta_password@localhost:5433/cosmoflow_db?schema=public"
# BD de los tests e2e (pnpm test:e2e). Se BORRA en cada ejecución: nunca la de desarrollo
DATABASE_URL_TEST="postgresql://cosmoflow:cambia_esta_password@localhost:5433/cosmoflow_db_test?schema=public"
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
JWT_SECRET="supersecret_local_key_change_in_prod"
# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGIN="http://localhost:5173"
# "true" solo si el backend está detrás de un proxy de confianza (Traefik/Dokploy):
# el rate limit usará la IP de X-Forwarded-For. En local, déjalo vacío.
TRUST_PROXY=""
# URL pública del frontend (enlaces de recuperar contraseña y verificar email)
APP_URL="http://localhost:5173"
# Envío de correos: SMTP si hay SMTP_HOST, si no Resend. Sin ninguno se escriben en consola
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# "true" para TLS directo (normalmente puerto 465); "false" para STARTTLS (normalmente puerto 587)
SMTP_SECURE="false"
RESEND_API_KEY=""
# Suele tener que ser una dirección del dominio o de la cuenta SMTP_USER
MAIL_FROM="Cosmoflow <no-reply@tu-dominio.com>"
# Archivos subidos (avatares). Sin S3_BUCKET se guardan en disco en STORAGE_DIR
STORAGE_DIR="uploads"
# S3 o compatible (Cloudflare R2: S3_ENDPOINT="https://<cuenta>.r2.cloudflarestorage.com", S3_REGION="auto")
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Login con Google (console.cloud.google.com > Credenciales > ID de cliente OAuth, tipo "Aplicación web").
# URI de redirección autorizada: <APP_URL>/api/auth/google/callback. Vacías: login con Google desactivado
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bot de Telegram para las notificaciones (crear con @BotFather). Vacío: canal desactivado
TELEGRAM_BOT_TOKEN=""

# Zona horaria de los recordatorios de vencimiento (avisan desde las 8:00 locales)
ZONA_HORARIA="America/Mexico_City"
