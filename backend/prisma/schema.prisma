generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
//  1. Entidades principales
// ─────────────────────────────────────────────

model Usuario {
  id        Int       @id @default(autoincrement()) @map("usr_id")
  email     String    @unique @map("usr_email") @db.VarChar(128)
  nombre    String    @map("usr_nombre") @db.VarChar(255)
  password  String    @map("usr_password") @db.VarChar(255)
  isActivo  Boolean   @default(true) @map("is_activo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  // Seguridad de la cuenta (módulo auth)
  emailVerificadoEn DateTime? @map("usr_email_verificado_en")
  intentosFallidos  Int       @default(0) @map("usr_intentos_fallidos")
  bloqueadoHasta    DateTime? @map("usr_bloqueado_hasta")
  /// `sub` de Google: identifica la cuenta aunque cambie el email
  googleId          String?   @unique @map("usr_google_id") @db.VarChar(255)

  /// Clave del avatar en el almacenamiento de archivos
  avatar    String?   @map("usr_avatar") @db.VarChar(255)
  /// Borrado lógico: los repositorios ignoran las filas con fecha
  deletedAt DateTime? @map("deleted_at")

  // Relaciones N-a-N gestionadas por tablas intermedias explícitas
  roles            UsuarioRol[]
  permisosDirectos UsuarioPermiso[]
  refreshTokens    RefreshToken[]
  tokensCuenta     TokenCuenta[]
  tags             Tag[]
  tareas           Tarea[]
  notas            Nota[]
  adjuntos         Adjunto[]
  organizaciones   MiembroOrganizacion[]

  @@map("usuario")
}

model Rol {
  id          Int       @id @default(autoincrement()) @map("rol_id")
  nombre      String    @unique @map("rol_nombre") @db.VarChar(150) // p. ej. 'ADMIN', 'MOD', 'USUARIO'
  descripcion String?   @map("rol_descripcion") @db.Text
  isActivo    Boolean   @default(true) @map("is_activo")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("rol")
}

/// Permiso atómico: combinación única de recurso + acción.
/// Ejemplo: recurso="turnos", accion="crear"
model Permiso {
  id        Int       @id @default(autoincrement()) @map("per_id")
  recurso   String    @map("per_recurso") @db.VarChar(100) // p. ej. "turnos", "usuarios"
  accion    String    @map("per_accion") @db.VarChar(50) // p. ej. "crear", "leer", "actualizar", "eliminar"
  isActivo  Boolean   @default(true) @map("is_activo")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  roles    RolPermiso[]
  usuarios UsuarioPermiso[]

  @@unique([recurso, accion])
  @@map("permiso")
}

// ─────────────────────────────────────────────
//  2. Tablas intermedias (N-a-N explícitas)
// ─────────────────────────────────────────────

/// Asigna roles a usuarios
model UsuarioRol {
  usuarioId Int      @map("usrrol_fkusuario")
  rolId     Int      @map("usrrol_fkrol")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

/// Permisos que posee un rol completo
model RolPermiso {
  rolId     Int @map("rolper_fkrol")
  permisoId Int @map("rolper_fkpermiso")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

/// Permisos directos o excepcionales por usuario (pueden conceder O denegar)
model UsuarioPermiso {
  usuarioId Int     @map("usrper_fkusuario")
  permisoId Int     @map("usrper_fkpermiso")
  /// true = conceder, false = denegar (override sobre el rol)
  concedido Boolean @default(true) @map("usrper_concedido")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permisoId])
  @@map("usuario_permiso")
}

// ─────────────────────────────────────────────
//  3. Refresh Tokens
// ─────────────────────────────────────────────

/// Token de refresco para la rotación segura de sesiones.
/// Se almacena un hash del token, nunca el token en claro.
model RefreshToken {
  id        Int      @id @default(autoincrement()) @map("rft_id")
  tokenHash String   @unique @map("rft_token_hash") @db.VarChar(512)
  usuarioId Int      @map("rft_fkusuario")
  expiraEn  DateTime @map("rft_expira_en")
  revocado  Boolean  @default(false) @map("rft_revocado")
  createdAt DateTime @default(now()) @map("rft_created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_token")
}

// ─────────────────────────────────────────────
//  4. Tokens de un solo uso (recuperar contraseña, verificar email)
// ─────────────────────────────────────────────

/// Se guarda el hash del token, nunca el token en claro.
model TokenCuenta {
  id        Int       @id @default(autoincrement()) @map("tkc_id")
  tokenHash String    @unique @map("tkc_token_hash") @db.VarChar(128)
  usuarioId Int       @map("tkc_fkusuario")
  /// "recuperar_password" | "verificar_email"
  tipo      String    @map("tkc_tipo") @db.VarChar(30)
  expiraEn  DateTime  @map("tkc_expira_en")
  usadoEn   DateTime? @map("tkc_usado_en")
  createdAt DateTime  @default(now()) @map("tkc_created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@map("token_cuenta")
}

// ─────────────────────────────────────────────
//  5. Outbox de eventos (módulo opcional eventos-outbox)
// ─────────────────────────────────────────────

/// Eventos de dominio guardados en la misma transacción que los datos; una tarea los entrega.
model EventoOutbox {
  id             Int       @id @default(autoincrement()) @map("evo_id")
  nombre         String    @map("evo_nombre") @db.VarChar(150)
  datos          Json      @map("evo_datos")
  ocurridoEn     DateTime  @map("evo_ocurrido_en")
  requestId      String?   @map("evo_request_id") @db.VarChar(100)
  usuarioId      Int?      @map("evo_usuario_id")
  procesadoEn    DateTime? @map("evo_procesado_en")
  reservadoHasta DateTime? @map("evo_reservado_hasta")
  intentos       Int       @default(0) @map("evo_intentos")
  ultimoError    String?   @map("evo_ultimo_error") @db.Text

  @@index([procesadoEn, id])
  @@map("evento_outbox")
}

// ─────────────────────────────────────────────
//  6. Auditoría (módulo opcional auditoria)
// ─────────────────────────────────────────────

/// Un registro por evento de dominio. Sin FK a usuario: el rastro sobrevive al borrado.
model Auditoria {
  id         Int      @id @default(autoincrement()) @map("aud_id")
  evento     String   @map("aud_evento") @db.VarChar(150)
  datos      Json     @map("aud_datos")
  usuarioId  Int?     @map("aud_usuario_id")
  requestId  String?  @map("aud_request_id") @db.VarChar(100)
  ocurridoEn DateTime @map("aud_ocurrido_en")

  @@index([ocurridoEn])
  @@index([evento])
  @@map("auditoria")
}

// Generado por gen:module: ajustar campos y @map a las convenciones de la tabla.
/// Tag de un usuario (sus notas y tareas personales) o de una organización (sus
/// equipos, proyectos y tareas), nunca de los dos: lo impone un CHECK (RN-60).
model Tag {
  id             Int       @id @default(autoincrement()) @map("tag_id")
  usuarioId      Int?      @map("tag_fkusuario")
  organizacionId Int?      @map("tag_fkorganizacion")
  nombre         String    @map("tag_nombre") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91). El nombre único por usuario lo valida la aplicación
  /// ignorando los borrados (Prisma no admite índices únicos parciales).
  deletedAt      DateTime? @map("deleted_at")

  usuario      Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacion Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tareas       TareaTag[]
  notas        NotaTag[]
  equipos      EquipoTag[]

  @@index([usuarioId])
  @@index([organizacionId])
  @@map("tag")
}

// Generado por gen:module: ajustar campos y @map a las convenciones de la tabla.
enum EstadoTarea {
  pendiente
  en_progreso
  completada
  cancelada

  @@map("estado_tarea")
}

enum PrioridadTarea {
  baja
  media
  alta

  @@map("prioridad_tarea")
}

/// Tarea personal (RN-40): de su dueño, sin equipo ni proyecto (llegan en la Fase 2).
model Tarea {
  id               Int            @id @default(autoincrement()) @map("tar_id")
  usuarioId        Int            @map("tar_fkusuario")
  titulo           String         @map("tar_titulo") @db.VarChar(255)
  /// Markdown (RN-41)
  contenido        String         @default("") @map("tar_contenido")
  estado           EstadoTarea    @default(pendiente) @map("tar_estado")
  prioridad        PrioridadTarea @default(media) @map("tar_prioridad")
  fechaInicio      DateTime?      @map("tar_fecha_inicio") @db.Date
  fechaVencimiento DateTime?      @map("tar_fecha_vencimiento") @db.Date
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime?      @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91)
  deletedAt        DateTime?      @map("deleted_at")

  /// Tarea compartida (RN-40): de la organización, de un equipo o de un proyecto
  /// (nunca de los dos). Sin organización es personal. CHECK en la migración.
  organizacionId   Int?           @map("tar_fkorganizacion")
  equipoId         Int?           @map("tar_fkequipo")
  proyectoId       Int?           @map("tar_fkproyecto")

  /// Quien la creó; en las personales, su dueño
  usuario      Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacion Organizacion?      @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  equipo       Equipo?            @relation(fields: [organizacionId, equipoId], references: [organizacionId, id], onDelete: Cascade)
  proyecto     Proyecto?          @relation(fields: [organizacionId, proyectoId], references: [organizacionId, id], onDelete: Cascade)
  tags         TareaTag[]
  responsables TareaResponsable[]

  /// Destino de la FK compuesta de `TareaResponsable`
  @@unique([organizacionId, id])
  @@index([usuarioId, estado])
  @@index([organizacionId])
  @@index([equipoId])
  @@index([proyectoId])
  @@map("tarea")
}

/// RN-44. FK a `MiembroOrganizacion`: salir de la organización lo quita como
/// responsable (decisión 20); las personales no pueden tenerlos (organización nula).
model TareaResponsable {
  organizacionId Int @map("tre_fkorganizacion")
  tareaId        Int @map("tre_fktarea")
  usuarioId      Int @map("tre_fkusuario")

  tarea   Tarea               @relation(fields: [organizacionId, tareaId], references: [organizacionId, id], onDelete: Cascade)
  miembro MiembroOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Cascade)

  @@id([tareaId, usuarioId])
  @@index([organizacionId, usuarioId])
  @@map("tarea_responsable")
}

model TareaTag {
  tareaId Int @map("tat_fktarea")
  tagId   Int @map("tat_fktag")

  tarea Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tareaId, tagId])
  @@index([tagId])
  @@map("tarea_tag")
}

// Generado por gen:module: ajustar campos y @map a las convenciones de la tabla.
/// Nota personal (RN-50): solo la ve su dueño. Las de proyecto llegan en la Fase 2.
model Nota {
  id        Int       @id @default(autoincrement()) @map("not_id")
  usuarioId Int       @map("not_fkusuario")
  titulo    String    @map("not_titulo") @db.VarChar(255)
  /// Markdown
  contenido String    @default("") @map("not_contenido")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91)
  deletedAt DateTime? @map("deleted_at")

  /// Nota de proyecto (RN-33): la ven sus miembros. Sin él, personal (RN-50).
  organizacionId Int? @map("not_fkorganizacion")
  proyectoId     Int? @map("not_fkproyecto")

  /// Quien la creó; en las personales, su dueño
  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto? @relation(fields: [organizacionId, proyectoId], references: [organizacionId, id], onDelete: Cascade)
  tags     NotaTag[]

  @@index([usuarioId, updatedAt])
  @@index([proyectoId, updatedAt])
  @@map("nota")
}

model NotaTag {
  notaId Int @map("ntt_fknota")
  tagId  Int @map("ntt_fktag")

  nota Nota @relation(fields: [notaId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([notaId, tagId])
  @@index([tagId])
  @@map("nota_tag")
}

/// Imagen subida por un usuario para sus tareas y notas (el markdown la enlaza
/// por URL). El archivo vive en el `Almacenamiento`, no en la base de datos.
model Adjunto {
  id        Int      @id @default(autoincrement()) @map("adj_id")
  usuarioId Int      @map("adj_fkusuario")
  clave     String   @unique @map("adj_clave") @db.VarChar(255)
  tipo      String   @map("adj_tipo") @db.VarChar(64)
  bytes     Int      @map("adj_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  /// Compartido con una organización, equipo o proyecto (sus miembros lo ven); sin
  /// ellos, solo su dueño. Se fija al subirlo desde una tarea o nota compartida o al
  /// mover la tarea.
  organizacionId Int? @map("adj_fkorganizacion")
  equipoId       Int? @map("adj_fkequipo")
  proyectoId     Int? @map("adj_fkproyecto")

  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacion Organizacion? @relation(fields: [organizacionId], references: [id], onDelete: SetNull)
  equipo   Equipo?   @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  proyecto Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("adjunto")
}

/// Espacio de trabajo compartido (RN-13). Solo la ven sus miembros (RN-90).
model Organizacion {
  id          Int       @id @default(autoincrement()) @map("org_id")
  nombre      String    @map("org_nombre") @db.VarChar(100)
  descripcion String    @default("") @map("org_descripcion") @db.VarChar(500)
  /// Hex `#rrggbb` (RN-15)
  color       String    @map("org_color") @db.VarChar(7)
  /// Clave en el almacenamiento; sin ella la interfaz muestra las iniciales
  avatar      String?   @map("org_avatar") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91)
  deletedAt   DateTime? @map("deleted_at")

  miembros     MiembroOrganizacion[]
  invitaciones Invitacion[]
  roles        RolOrganizacion[]
  tags         Tag[]
  equipos      Equipo[]
  proyectos    Proyecto[]
  tareas       Tarea[]
  adjuntos     Adjunto[]

  @@map("organizacion")
}

/// Pertenencia de un usuario a una organización (RN-02, RN-10).
model MiembroOrganizacion {
  organizacionId Int      @map("mor_fkorganizacion")
  usuarioId      Int      @map("mor_fkusuario")
  /// RN-11: el creador lo es por defecto
  isAdmin        Boolean  @default(false) @map("mor_is_admin")
  createdAt      DateTime @default(now()) @map("created_at")

  organizacion Organizacion             @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuario      Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  roles        MiembroRolOrganizacion[]
  equipos      MiembroEquipo[]
  proyectos    IntegranteProyecto[]
  tareas       TareaResponsable[]

  @@id([organizacionId, usuarioId])
  @@index([usuarioId])
  @@map("miembro_organizacion")
}

enum EstadoInvitacion {
  pendiente
  aceptada
  rechazada
  cancelada

  @@map("estado_invitacion")
}

/// Única vía para entrar en una organización (RN-12). Se guarda el hash del token,
/// nunca el token en claro.
model Invitacion {
  id             Int              @id @default(autoincrement()) @map("inv_id")
  organizacionId Int              @map("inv_fkorganizacion")
  /// En minúsculas
  email          String           @map("inv_email") @db.VarChar(128)
  tokenHash      String           @unique @map("inv_token_hash") @db.VarChar(128)
  estado         EstadoInvitacion @default(pendiente) @map("inv_estado")
  expiraEn       DateTime         @map("inv_expira_en")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime?        @updatedAt @map("updated_at")

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId, estado])
  @@map("invitacion")
}

/// Rol personalizado de una organización (RN-14). Sus permisos salen del catálogo fijo
/// `PERMISOS_ORGANIZACION` del módulo `organizacion` (RN-17); los valida la aplicación.
model RolOrganizacion {
  id             Int       @id @default(autoincrement()) @map("rog_id")
  organizacionId Int       @map("rog_fkorganizacion")
  nombre         String    @map("rog_nombre") @db.VarChar(64)
  permisos       String[]  @map("rog_permisos")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91). El nombre único por organización lo valida la aplicación
  /// ignorando los borrados.
  deletedAt      DateTime? @map("deleted_at")

  organizacion Organizacion             @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  miembros     MiembroRolOrganizacion[]

  /// Destino de la FK compuesta de `MiembroRolOrganizacion`
  @@unique([organizacionId, id])
  @@index([organizacionId])
  @@map("rol_organizacion")
}

/// Roles de un miembro (N:M). Las FK llevan las dos `organizacionId`: la BD impide
/// dar a un miembro un rol de otra organización (RN-90).
model MiembroRolOrganizacion {
  organizacionId Int @map("mro_fkorganizacion")
  usuarioId      Int @map("mro_fkusuario")
  rolId          Int @map("mro_fkrol")

  miembro MiembroOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Cascade)
  rol     RolOrganizacion     @relation(fields: [organizacionId, rolId], references: [organizacionId, id], onDelete: Cascade)

  @@id([organizacionId, usuarioId, rolId])
  @@index([organizacionId, rolId])
  @@map("miembro_rol_organizacion")
}

/// Grupo dentro de una organización (RN-20).
model Equipo {
  id             Int       @id @default(autoincrement()) @map("eq_id")
  organizacionId Int       @map("eq_fkorganizacion")
  nombre         String    @map("eq_nombre") @db.VarChar(100)
  descripcion    String    @default("") @map("eq_descripcion") @db.VarChar(500)
  /// Hex `#rrggbb` (RN-25)
  color          String    @map("eq_color") @db.VarChar(7)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91)
  deletedAt      DateTime? @map("deleted_at")

  organizacion Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  miembros     MiembroEquipo[]
  tags         EquipoTag[]
  proyectos    ProyectoEquipo[]
  tareas       Tarea[]
  adjuntos     Adjunto[]

  /// Destino de las FK compuestas de `MiembroEquipo` y `ProyectoEquipo`
  @@unique([organizacionId, id])
  @@index([organizacionId])
  @@map("equipo")
}

/// FK compuesta a `MiembroOrganizacion`: solo miembros de la organización, y salir de
/// ella los quita del equipo. Un solo líder por equipo (índice parcial en la migración).
model MiembroEquipo {
  organizacionId   Int     @map("meq_fkorganizacion")
  equipoId         Int     @map("meq_fkequipo")
  usuarioId        Int     @map("meq_fkusuario")
  /// RN-21
  isLider          Boolean @default(false) @map("meq_is_lider")
  /// Delegado del líder (RN-22)
  puedeCrearTareas Boolean @default(false) @map("meq_puede_crear_tareas")

  equipo  Equipo              @relation(fields: [organizacionId, equipoId], references: [organizacionId, id], onDelete: Cascade)
  miembro MiembroOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Cascade)

  @@id([equipoId, usuarioId])
  @@index([organizacionId, usuarioId])
  @@map("miembro_equipo")
}

/// RN-24. Que el tag sea de la misma organización lo valida la aplicación.
model EquipoTag {
  equipoId Int @map("eqt_fkequipo")
  tagId    Int @map("eqt_fktag")

  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([equipoId, tagId])
  @@index([tagId])
  @@map("equipo_tag")
}

enum EstadoProyecto {
  activo
  en_pausa
  terminado

  @@map("estado_proyecto")
}

/// Trabajo dentro de una organización (RN-30), con al menos un equipo (RN-31).
model Proyecto {
  id             Int            @id @default(autoincrement()) @map("pry_id")
  organizacionId Int            @map("pry_fkorganizacion")
  nombre         String         @map("pry_nombre") @db.VarChar(100)
  descripcion    String         @default("") @map("pry_descripcion") @db.VarChar(500)
  estado         EstadoProyecto @default(activo) @map("pry_estado")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime?      @updatedAt @map("updated_at")
  /// Borrado lógico (RN-91)
  deletedAt      DateTime?      @map("deleted_at")

  organizacion Organizacion         @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  equipos      ProyectoEquipo[]
  integrantes  IntegranteProyecto[]
  tareas       Tarea[]
  notas        Nota[]
  adjuntos     Adjunto[]

  /// Destino de las FK compuestas de `ProyectoEquipo` e `IntegranteProyecto`
  @@unique([organizacionId, id])
  @@index([organizacionId])
  @@map("proyecto")
}

/// FK compuestas: el equipo es de la misma organización que el proyecto.
model ProyectoEquipo {
  organizacionId Int @map("pre_fkorganizacion")
  proyectoId     Int @map("pre_fkproyecto")
  equipoId       Int @map("pre_fkequipo")

  proyecto Proyecto @relation(fields: [organizacionId, proyectoId], references: [organizacionId, id], onDelete: Cascade)
  equipo   Equipo   @relation(fields: [organizacionId, equipoId], references: [organizacionId, id], onDelete: Cascade)

  @@id([proyectoId, equipoId])
  @@index([organizacionId, equipoId])
  @@map("proyecto_equipo")
}

/// Integrante suelto (RN-32). FK a `MiembroOrganizacion`: salir de ella lo quita del proyecto.
model IntegranteProyecto {
  organizacionId Int @map("ipr_fkorganizacion")
  proyectoId     Int @map("ipr_fkproyecto")
  usuarioId      Int @map("ipr_fkusuario")

  proyecto Proyecto            @relation(fields: [organizacionId, proyectoId], references: [organizacionId, id], onDelete: Cascade)
  miembro  MiembroOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Cascade)

  @@id([proyectoId, usuarioId])
  @@index([organizacionId, usuarioId])
  @@map("integrante_proyecto")
}
