{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"strict": true,
		"types": ["bun"],
		"lib": ["ESNext"]
	},
	"include": ["src/**/*"]
}
