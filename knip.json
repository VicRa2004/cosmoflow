{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"rules": {
		"files": "warn",
		"dependencies": "error",
		"unlisted": "error",
		"exports": "warn",
		"types": "off",
		"nsExports": "off",
		"nsTypes": "off",
		"duplicates": "off",
		"enumMembers": "off"
	},
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": ["flutter", "dart"],
	"workspaces": {
		".": {
			"entry": ["scripts/*.ts"]
		},
		"backend": {
			"entry": [
				"scripts/**/*.ts",
				"src/**/*.spec.ts",
				"src/modules/*/module.ts",
				"prisma/seed-demo.ts"
			],
			"project": ["src/**/*.ts", "scripts/**/*.ts", "prisma/**/*.ts"],
			"ignoreDependencies": ["@prisma/client", "@swc/core"]
		},
		"frontend": {
			"entry": [
				"src/routes/**/!(*.test|*.spec).{ts,tsx}",
				"src/modules/adjuntos/editor/movil.ts",
				"vite.editor-movil.config.ts"
			],
			"project": ["src/**/*.{ts,tsx}"],
			"ignoreDependencies": ["tailwindcss"]
		}
	}
}
